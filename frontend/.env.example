# Treasury Chamber - environment configuration
#
# Copy to .env.local to override. Every value is optional: the canonical
# StudioNet deployment is compiled in, so the app runs with no .env at all.
#
# There are no secrets here and none are needed. This is a static frontend with
# no backend; it holds no API keys and never handles a private key.

# Deployed Treasury Trial contract.
#
# Leave this UNSET to use the canonical StudioNet deployment. If you set it, it
# must be a 0x-prefixed 40-hex-character address: an empty or malformed value
# makes the app refuse to start with a visible configuration error rather than
# render an empty protocol that looks real.
VITE_TREASURY_TRIAL_ADDRESS=0x7cD15c0d4F4741C2Ce3DD807246b6f13aA7f82A1

# StudioNet RPC endpoint. Defaults to the genlayer-js studionet chain value.
# VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Block explorer base, used for transaction and address links.
# VITE_GENLAYER_EXPLORER_URL=https://genlayer-explorer.vercel.app

# How long to wait for a transaction receipt before reporting TIMEOUT.
# Adjudication is the slowest call in the protocol; the defaults allow it
# roughly ten minutes.
# VITE_RECEIPT_RETRIES=200
# VITE_RECEIPT_INTERVAL_MS=3000
